{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/godfather-godmother",
      "destination": "/index"
    },
    {
      "source": "/bridesmaid",
      "destination": "/index"
    },
    {
      "source": "/groomsmen",
      "destination": "/index"
    },
    {
      "source": "/guest",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}